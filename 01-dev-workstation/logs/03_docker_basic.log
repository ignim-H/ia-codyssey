# --- 컨테이너 실행(백그라운드) / 목록 / 중지 ---
$ docker run -d --name ubuntu-keep ubuntu:22.04 sleep infinity
8fee012f685e380fc26636e2355f4918f28b41714f86cf204a89ab6991329605

$ docker ps
CONTAINER ID   IMAGE          COMMAND            CREATED        STATUS                  PORTS     NAMES
8fee012f685e   ubuntu:22.04   "sleep infinity"   1 second ago   Up Less than a second             ubuntu-keep

$ docker exec ubuntu-keep bash -c 'echo hello from exec; ls /tmp'
hello from exec

$ docker stop ubuntu-keep
ubuntu-keep

$ docker ps
CONTAINER ID   IMAGE     COMMAND   CREATED   STATUS    PORTS     NAMES

$ docker ps -a
CONTAINER ID   IMAGE          COMMAND            CREATED         STATUS                                PORTS     NAMES
8fee012f685e   ubuntu:22.04   "sleep infinity"   5 seconds ago   Exited (137) Less than a second ago             ubuntu-keep
62368fec76c8   hello-world    "/hello"           7 seconds ago   Exited (0) 6 seconds ago                        hello-test

# --- attach vs exec 관찰 ---
$ docker run -di --name attach-test ubuntu:22.04 bash
e7ea6cd2427106e59d2ab8a4c944cab93779360b235a3f8787d8da06cc508f04

$ docker exec attach-test bash -c 'exit 0'; docker ps --filter name=attach-test --format '{{.Names}} {{.Status}}'
attach-test Up Less than a second

$ echo 'exit' | docker attach attach-test; sleep 1; docker ps -a --filter name=attach-test --format '{{.Names}} {{.Status}}'
attach-test Exited (0) 1 second ago

# --- 로그 / 리소스 확인 ---
$ docker logs hello-test | head -5

